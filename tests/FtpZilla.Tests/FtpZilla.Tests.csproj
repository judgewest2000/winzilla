<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The WinUI app can't be referenced from a plain test project, so compile its UI-free storage code directly. -->
  <ItemGroup>
    <Compile Include="..\..\winui3\Services\ConnectionModels.cs" Link="Services\ConnectionModels.cs" />
    <Compile Include="..\..\winui3\Services\SecretProtector.cs" Link="Services\SecretProtector.cs" />
    <Compile Include="..\..\winui3\Services\ConnectionStore.cs" Link="Services\ConnectionStore.cs" />
  </ItemGroup>

</Project>
