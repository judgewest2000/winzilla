<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Winzilla.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Winzilla.Services">

    <Page.Resources>
        <DataTemplate x:Key="FileRow" x:DataType="svc:FileEntry">
            <Grid ColumnSpacing="8" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="{x:Bind Icon}" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalTextAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PaneButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="LogItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <DataTemplate x:Key="LogRow" x:DataType="svc:LogLine">
            <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="12,0,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="SavedBox" Header="Saved connections" Width="220" SelectionChanged="SavedBox_Changed"
                      AutomationProperties.Name="Saved connections" />
            <Button x:Name="SaveSavedButton" Content="Save" VerticalAlignment="Bottom" Click="SaveConnection_Click"
                    AutomationProperties.Name="Save connection" />
            <Button x:Name="DeleteSavedButton" Content="Delete" VerticalAlignment="Bottom" IsEnabled="False"
                    Click="DeleteConnection_Click" AutomationProperties.Name="Delete saved connection" />
            <CheckBox x:Name="RememberBox" Content="Remember password" VerticalAlignment="Bottom"
                      AutomationProperties.Name="Remember password in the Windows Credential Locker" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="ProtocolBox" Header="Protocol" Width="100" SelectionChanged="Protocol_Changed">
                <ComboBoxItem Content="SFTP" />
                <ComboBoxItem Content="FTP" />
            </ComboBox>
            <TextBox x:Name="HostBox" Header="Host" Width="200" PlaceholderText="example.com" KeyDown="Connect_KeyDown" />
            <TextBox x:Name="PortBox" Header="Port" Width="70" KeyDown="Connect_KeyDown" />
            <TextBox x:Name="UserBox" Header="Username" Width="140" KeyDown="Connect_KeyDown" />
            <PasswordBox x:Name="PasswordBox" Header="Password" Width="160" KeyDown="Connect_KeyDown" />
            <Button x:Name="ConnectButton" Content="Connect" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}" Click="Connect_Click" />
        </StackPanel>
        </StackPanel>

        <!-- Remote -->
        <Grid x:Name="RemotePane" Grid.Row="1" RowSpacing="6" AllowDrop="True" Background="Transparent"
              DragOver="RemotePane_DragOver" Drop="RemotePane_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="RemoteTitle" Text="Remote (not connected)" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid Grid.Row="1" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PaneButton}" Click="RemoteUp_Click"
                        AutomationProperties.Name="Up" ToolTipService.ToolTip="Up">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
                <Button Grid.Column="1" Style="{StaticResource PaneButton}" Click="RemoteRefresh_Click"
                        AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <TextBox Grid.Column="2" x:Name="RemotePathBox" AutomationProperties.Name="Remote path" KeyDown="RemotePath_KeyDown" />
                <Button Grid.Column="3" Style="{StaticResource PaneButton}" Click="Upload_Click"
                        AutomationProperties.Name="Upload files" ToolTipService.ToolTip="Upload files…">
                    <FontIcon Glyph="&#xE898;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource PaneButton}" Click="Download_Click"
                        AutomationProperties.Name="Download selected" ToolTipService.ToolTip="Download selected to your Downloads folder">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                </Button>
                <Button Grid.Column="5" Style="{StaticResource PaneButton}" Click="RemoteNewFolder_Click"
                        AutomationProperties.Name="New folder" ToolTipService.ToolTip="New folder">
                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                </Button>
                <Button Grid.Column="6" Style="{StaticResource PaneButton}" Click="RemoteRename_Click"
                        AutomationProperties.Name="Rename" ToolTipService.ToolTip="Rename">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                </Button>
                <Button Grid.Column="7" Style="{StaticResource PaneButton}" Click="RemoteDelete_Click"
                        AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Sortable column headers -->
            <Grid Grid.Row="2" ColumnSpacing="8" Padding="12,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SortNameButton" Style="{StaticResource HeaderButton}" Tag="Name" Click="Sort_Click"
                        AutomationProperties.Name="Sort by name" HorizontalContentAlignment="Left" />
                <Button x:Name="SortSizeButton" Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="Size" Click="Sort_Click"
                        AutomationProperties.Name="Sort by size" HorizontalContentAlignment="Right" />
                <Button x:Name="SortModifiedButton" Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="Modified" Click="Sort_Click"
                        AutomationProperties.Name="Sort by date modified" HorizontalContentAlignment="Left" />
            </Grid>

            <ListView Grid.Row="3" x:Name="RemoteList" ItemTemplate="{StaticResource FileRow}"
                      SelectionMode="Extended" CanDragItems="True" IsDoubleTapEnabled="True"
                      ContextRequested="RemoteList_ContextRequested"
                      AutomationProperties.Name="Remote files"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      DragItemsStarting="RemoteList_DragItemsStarting" DragItemsCompleted="List_DragItemsCompleted"
                      DoubleTapped="RemoteList_DoubleTapped" KeyDown="RemoteList_KeyDown">
        <ListView.ContextFlyout><MenuFlyout Opening="RemoteMenu_Opening">
            <MenuFlyoutItem x:Name="MenuOpen" Text="Open" Click="MenuOpen_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuDownload" Text="Download" Click="Download_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuUpload" Text="Upload files…" Click="Upload_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="MenuCut" Text="Cut" KeyboardAcceleratorTextOverride="Ctrl+X" Click="Cut_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuCopy" Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" Click="Copy_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuPaste" Text="Paste" KeyboardAcceleratorTextOverride="Ctrl+V" Click="Paste_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="MenuRename" Text="Rename" KeyboardAcceleratorTextOverride="F2" Click="RemoteRename_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuDelete" Text="Delete" KeyboardAcceleratorTextOverride="Del" Click="RemoteDelete_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="MenuNewFolder" Text="New folder" Click="RemoteNewFolder_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuRefresh" Text="Refresh" KeyboardAcceleratorTextOverride="F5" Click="RemoteRefresh_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="MenuProperties" Text="Properties" KeyboardAcceleratorTextOverride="Alt+Enter" Click="Properties_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout></ListView.ContextFlyout>
                <ListView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="Copy_Invoked" />
                    <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="Cut_Invoked" />
                    <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="Paste_Invoked" />
                    <KeyboardAccelerator Key="F2" Invoked="Rename_Invoked" />
                    <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
                    <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="Properties_Invoked" />
                </ListView.KeyboardAccelerators>
            </ListView>
        </Grid>

        <!-- Transfer progress -->
        <Grid Grid.Row="2" x:Name="TransferPanel" Visibility="Collapsed" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TransferPath" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Current transfer" />
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TransferElapsed" MinWidth="120" VerticalAlignment="Center" AutomationProperties.Name="Time elapsed" />
                <TextBlock Grid.Column="1" x:Name="TransferLeft" MinWidth="100" VerticalAlignment="Center" AutomationProperties.Name="Time left" />
                <ProgressBar Grid.Column="2" x:Name="TransferBar" Minimum="0" Maximum="100" VerticalAlignment="Center"
                             AutomationProperties.Name="Transfer progress" />
                <TextBlock Grid.Column="3" x:Name="TransferBytes" VerticalAlignment="Center" AutomationProperties.Name="Bytes transferred" />
            </Grid>
        </Grid>

        <!-- Command log -->
        <Grid Grid.Row="3" RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="120" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Command log" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <HyperlinkButton Content="Export" Padding="4,0" Click="ExportLog_Click"
                                     AutomationProperties.Name="Export command log" />
                    <HyperlinkButton Content="Clear" Padding="4,0" Click="ClearLog_Click"
                                     AutomationProperties.Name="Clear command log" />
                </StackPanel>
            </Grid>
            <ListView Grid.Row="1" x:Name="LogList" SelectionMode="None" ItemTemplate="{StaticResource LogRow}"
                      ItemContainerStyle="{StaticResource LogItem}" AutomationProperties.Name="Command log"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="1" x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" />
            <HyperlinkButton Grid.Column="3" x:Name="AboutButton" Content="About" AutomationProperties.Name="About Winzilla" Click="About_Click" />
        </Grid>
    </Grid>
</Page>
