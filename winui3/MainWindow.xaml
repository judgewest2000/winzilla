<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Winzilla.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Winzilla">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Winzilla">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <!-- Shows the connected server's group, tinted with the group colour -->
            <Border x:Name="TitleGroupBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                    HorizontalAlignment="Left" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="TitleGroupLock" Glyph="&#xE72E;" FontSize="11" Visibility="Collapsed"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="TitleGroupText" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
